@prefix ex: <http://example.org/mkr/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Airline a rdfs:Class .

ex:BudgetFlight a rdfs:Class ;
    rdfs:subClassOf ex:Flight .

ex:City a rdfs:Class .

ex:Country a rdfs:Class .

ex:Flight a rdfs:Class .

ex:LongFlight a rdfs:Class ;
    rdfs:subClassOf ex:Flight .

ex:arrivesAt a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:City .

ex:departsFrom a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:City .

ex:departureDate a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:date .

ex:durationMin a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:integer .

<http://example.org/mkr/flight/FL-1254> a ex:Flight ;
    ex:arrivesAt <http://example.org/mkr/city/Lyon> ;
    ex:departsFrom <http://example.org/mkr/city/Berlin> ;
    ex:departureDate "2026-05-20"^^xsd:date ;
    ex:durationMin 124 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/SkyNord> .

<http://example.org/mkr/flight/FL-2327> a ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Vienna> ;
    ex:departsFrom <http://example.org/mkr/city/Warsaw> ;
    ex:departureDate "2026-03-26"^^xsd:date ;
    ex:durationMin 283 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/SkyNord> ;
    ex:priceEur 226.50 .

<http://example.org/mkr/flight/FL-3051> a ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Milan> ;
    ex:departsFrom <http://example.org/mkr/city/Tallinn> ;
    ex:departureDate "2026-05-08"^^xsd:date ;
    ex:durationMin 284 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/Blue_Meridian> ;
    ex:priceEur 172.00 .

<http://example.org/mkr/flight/FL-3242> a ex:BudgetFlight,
        ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Madrid> ;
    ex:departsFrom <http://example.org/mkr/city/Prague> ;
    ex:departureDate "2026-04-21"^^xsd:date ;
    ex:durationMin 246 ;
    ex:operatedBy <http://example.org/mkr/airline/AeroVista> ;
    ex:priceEur 80.00 .

<http://example.org/mkr/flight/FL-3285> a ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Madrid> ;
    ex:departsFrom <http://example.org/mkr/city/Odesa> ;
    ex:departureDate "2026-06-01"^^xsd:date ;
    ex:durationMin 302 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/AeroVista> ;
    ex:priceEur 119.50 .

<http://example.org/mkr/flight/FL-3688> a ex:BudgetFlight,
        ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Madrid> ;
    ex:departsFrom <http://example.org/mkr/city/Warsaw> ;
    ex:departureDate "2026-07-11"^^xsd:date ;
    ex:durationMin 314 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/AeroVista> ;
    ex:priceEur 67.00 .

<http://example.org/mkr/flight/FL-4390> a ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Rome> ;
    ex:departsFrom <http://example.org/mkr/city/Oslo> ;
    ex:departureDate "2026-08-20"^^xsd:date ;
    ex:durationMin 295 ;
    ex:operatedBy <http://example.org/mkr/airline/Blue_Meridian> ;
    ex:priceEur 242.50 .

<http://example.org/mkr/flight/FL-4418> a ex:Flight ;
    ex:arrivesAt <http://example.org/mkr/city/Prague> ;
    ex:departsFrom <http://example.org/mkr/city/Munich> ;
    ex:departureDate "2026-08-22"^^xsd:date ;
    ex:durationMin 173 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/Zephyr_Lines> ;
    ex:priceEur 200.99 .

<http://example.org/mkr/flight/FL-5931> a ex:BudgetFlight,
        ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Lviv> ;
    ex:departsFrom <http://example.org/mkr/city/Kyiv> ;
    ex:departureDate "2026-04-08"^^xsd:date ;
    ex:durationMin 298 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/Blue_Meridian> ;
    ex:priceEur 80.00 .

<http://example.org/mkr/flight/FL-7159> a ex:Flight ;
    ex:arrivesAt <http://example.org/mkr/city/Rome> ;
    ex:departsFrom <http://example.org/mkr/city/Vilnius> ;
    ex:departureDate "2026-06-09"^^xsd:date ;
    ex:durationMin 151 ;
    ex:operatedBy <http://example.org/mkr/airline/Zephyr_Lines> ;
    ex:priceEur 157.00 .

<http://example.org/mkr/flight/FL-8577> a ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Odesa> ;
    ex:departsFrom <http://example.org/mkr/city/Warsaw> ;
    ex:departureDate "2026-07-16"^^xsd:date ;
    ex:durationMin 252 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/Falcon_Jet> ;
    ex:priceEur 219.99 .

ex:fromBusyCountry a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:boolean .

ex:locatedIn a rdf:Property ;
    rdfs:domain ex:City ;
    rdfs:range ex:Country .

ex:operatedBy a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:Airline .

ex:priceEur a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:decimal .

ex:reportedBy a rdf:Property ;
    rdfs:domain rdf:Statement ;
    rdfs:range rdfs:Resource .

<http://example.org/mkr/stmt/FL-2334-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/FlightLog> ;
    rdf:object 25 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-2334> .

<http://example.org/mkr/stmt/FL-2928-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/PassengerReport> ;
    rdf:object 90 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-2928> .

<http://example.org/mkr/stmt/FL-5857-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/FlightLog> ;
    rdf:object 40 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-5857> .

<http://example.org/mkr/stmt/FL-6113-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/PassengerReport> ;
    rdf:object 15 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-6113> .

<http://example.org/mkr/stmt/FL-6364-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/PassengerReport> ;
    rdf:object 40 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-6364> .

<http://example.org/mkr/airline/Falcon_Jet> a ex:Airline ;
    rdfs:label "Falcon Jet"@en .

<http://example.org/mkr/airline/Orbit_Airways> a ex:Airline ;
    rdfs:label "Orbit Airways"@en .

